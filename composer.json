{
    "name": "hello-lemon/lemonfacturx-vendor-build",
    "authors": [
        {
            "name": "cbwar",
            "email": "cbwar@protonmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "setasign/fpdf": "^1.9",
        "setasign/fpdi": "^2.6",
        "atgp/factur-x": "^3.3"
    },
    "conflict": {
        "php": "<8.2.35|>=8.3,<8.3.36|>=8.4,<8.4.27|>=8.5,<8.5.12"
    },
    "scripts": {
        "post-install-cmd": "for f in patches/*.patch; do patch -p1 -N < \"$f\" || true; done",
        "post-update-cmd": "@post-install-cmd"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "phpcompatibility/php-compatibility": "^9.3"
    }
}
